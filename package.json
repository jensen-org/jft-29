{
  "name": "@jensen-org/jft-29",
  "version": "0.2.0",
  "description": "A small, event driven, dependency free file tree with a Vue 3 layer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jensen-org/jft-29.git"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./editor": {
      "types": "./dist/types/editor/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./languages": {
      "types": "./dist/types/languages/index.d.ts",
      "import": "./dist/languages.js"
    },
    "./icons/material": {
      "types": "./dist/types/icons/material.d.ts",
      "import": "./dist/icons/material.js"
    },
    "./icons/symbols": {
      "types": "./dist/types/icons/symbols.d.ts",
      "import": "./dist/icons/symbols.js"
    },
    "./style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check .",
    "lint:staged": "biome check --staged --no-errors-on-unmatched",
    "test": "vitest run",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/finish-types.mjs && node scripts/gen-icons.mjs --copy",
    "deps": "node scripts/check-deps.mjs",
    "gen": "node scripts/gen-languages.mjs && node scripts/gen-icons.mjs",
    "gen:check": "node scripts/gen-languages.mjs --check && node scripts/gen-icons.mjs --check",
    "package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./style.css",
    "check": "bun run typecheck && bun run lint && bun run test && bun run gen:check && bun run build && bun run deps && bun run package",
    "dev": "node scripts/gen-icons.mjs --copy && vite playground",
    "review": "ocr delegate preview --exclude '**/*.generated.ts,dist/**,bun.lock'",
    "review:branch": "ocr delegate preview --exclude '**/*.generated.ts,dist/**,bun.lock' --from origin/main --to HEAD",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@biomejs/biome": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "linguist-languages": "9.5.0",
    "material-icon-theme": "5.39.0",
    "publint": "^0.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.3",
    "vscode-symbols": "0.0.20",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
